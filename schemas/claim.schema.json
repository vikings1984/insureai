{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vikings1984.github.io/insureai/schemas/claim.schema.json",
  "title": "InsureAI Claim",
  "type": "object",
  "required": ["claim_id", "text", "status", "evidence_refs"],
  "properties": {
    "claim_id": {"type": "string", "minLength": 1},
    "text": {"type": "string", "minLength": 1},
    "type": {"type": "string"},
    "status": {"enum": ["single_source", "cross_checked", "conflicted", "unverified"]},
    "evidence_refs": {"type": "array"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 100}
  },
  "additionalProperties": true
}
