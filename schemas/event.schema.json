{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vikings1984.github.io/insureai/schemas/event.schema.json",
  "title": "InsureAI Event",
  "type": "object",
  "required": ["event_id", "event_fingerprint", "title", "event_type", "published_at", "article_ids", "scores", "evidence", "trust"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "event_fingerprint": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "event_type": {"type": "string", "minLength": 1},
    "entities": {"type": "array", "items": {"type": "string"}},
    "topic": {"type": ["string", "null"]},
    "published_at": {"type": "string"},
    "source_count": {"type": "integer", "minimum": 0},
    "article_count": {"type": "integer", "minimum": 0},
    "article_ids": {"type": "array"},
    "scores": {
      "type": "object",
      "required": ["relevance", "impact", "novelty", "actionability", "confidence", "intelligence_score"],
      "properties": {
        "relevance": {"type": "number", "minimum": 0, "maximum": 100},
        "impact": {"type": "number", "minimum": 0, "maximum": 100},
        "novelty": {"type": "number", "minimum": 0, "maximum": 100},
        "actionability": {"type": "number", "minimum": 0, "maximum": 100},
        "confidence": {"type": "number", "minimum": 0, "maximum": 100},
        "intelligence_score": {"type": "number", "minimum": 0, "maximum": 100}
      },
      "additionalProperties": true
    },
    "insight": {"type": "object"},
    "evidence": {"type": "array", "items": {"$ref": "evidence.schema.json"}},
    "evidence_coverage": {"type": "number", "minimum": 0, "maximum": 100},
    "review_required": {"type": "boolean"},
    "trust": {"type": "object"}
  },
  "additionalProperties": true
}
